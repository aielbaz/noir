---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

// A zoomed part of a screenshot: the image is positioned inside an overflow-hidden frame.
interface Props { src: ImageMetadata; alt: string; width: string; left: string; top: string; aspect?: string; class?: string }
const { src, alt, width, left, top, aspect = '4 / 3', class: className } = Astro.props
---
<div class:list={['crop', className]} style={`aspect-ratio: ${aspect}`}>
  <Image src={src} alt={alt} widths={[1080, 1600, 1920]} sizes="(max-width: 900px) 200vw, 760px" format="webp"
    loading="lazy" decoding="async" style={`width: ${width}; left: ${left}; top: ${top}`} />
</div>
