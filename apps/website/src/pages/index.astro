---
import Base from '../layouts/Base.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import TvFrame from '../components/TvFrame.astro'
import Crop from '../components/Crop.astro'
import homeRows from '../assets/screens/home-rows.png'
import movies from '../assets/screens/movies.png'
import seriesList from '../assets/screens/series-list.png'
import liveTv from '../assets/screens/live-tv.png'
import player from '../assets/screens/player.png'
import seriesDetails from '../assets/screens/series-details.png'
import settings from '../assets/screens/settings.png'
import movieDetails from '../assets/screens/movie-details.png'

const captions = [
  ['Made for your remote', 'Everything works with the arrow buttons and OK. Pointing with the Magic Remote works too.'],
  ['Fast with big libraries', 'Noir remembers your lists, so even very large ones open and scroll smoothly.'],
  ['A banner that waits', 'New titles rotate on Home, and pause while you move through the menu.'],
]

const tiles = [
  { cls: 'wide', figure: 'skip', title: 'Skip ahead, fast.', text: 'Hold the button to skip forward. The longer you hold, the faster it goes.' },
  { cls: 'tall', figure: '1.5×', title: 'Your speed.', text: 'Watch faster or slower, and keep your favourite as the default.' },
  { cls: '', figure: '−1:17', title: 'Time left, or time in.', text: 'Switch the clock between time watched and time left.' },
  { cls: '', figure: 'Ends 10:42', title: 'Know when it ends.', text: 'The finish time, in your local time.' },
  { cls: '', figure: '3.22 GB', title: 'Know the size.', text: 'See how big the video is, right in the player.' },
]

const cards = [
  { img: homeRows, alt: 'Continue watching cards with progress bars and minutes left', width: '200%', left: '-12%', top: '0', title: 'Never lose your place.', text: 'Progress is saved while you watch, with minutes left on every card.' },
  { img: seriesDetails, alt: 'Episode list with the first episode marked Up next', width: '200%', left: '-12%', top: '-22%', title: 'Binge, hands free.', text: 'Autoplay starts the next episode, and an Up next card shows what’s coming.' },
  { img: settings, alt: 'Playback settings: autoplay next episode, up next card and default speed', width: '200%', left: '-10%', top: '-66%', title: 'Make it yours.', text: 'Choose what’s on your Home screen, how lists are sorted, your playback speed and more.' },
  { img: movieDetails, alt: 'Movie details with Play and My list buttons', width: '220%', left: '-10%', top: '-54%', title: 'Save it for later.', text: 'Hold OK on any title to add it to My list.' },
  { img: movies, alt: 'Movies screen with the sort button and the Search all movies field above the posters', width: '200%', left: '-100%', top: '0', title: 'Find it fast.', text: 'Search and sort every list, across Live TV, movies and shows.' },
  { audio: true, title: 'Your language.', text: 'When a video has more than one audio track, switch between them as you watch.' },
]

const steps = [
  ['Install Noir', 'From the app store on your LG TV, once it’s available.'],
  ['Sign in', 'Type in the login details your provider gave you.'],
  ['Lights off', 'Your channels, movies and shows are ready to watch.'],
]

const faq = [
  ['Does Noir include channels or movies?', 'No. Noir is the app you watch with. The channels and movies come from your own TV subscription, which you sign in to.'],
  ['What kind of subscription do I need?', 'One that gives you an Xtream Codes login: a server address, a username and a password. Your provider can tell you if you’re not sure.'],
  ['Which TVs does it work on?', 'LG smart TVs running webOS [SUPPORTED VERSIONS].'],
  ['Is Noir free?', '[PRICE]'],
  ['Is my login safe?', 'Your sign-in details are stored on your TV and used only to connect to the server you enter. There’s no Noir account and no Noir server. Signing out clears everything.'],
  ['Will my videos play?', 'Noir plays the common streaming and video formats (HLS, MP4 and MKV). Subtitles built into MKV files may not show, depending on the TV.'],
  ['Does it work with the Magic Remote?', 'Yes. You can point and click, and scroll with the wheel. The regular arrow buttons work everywhere too.'],
]
---
<Base
  title="Noir — IPTV player for LG webOS TVs"
  description="A calm, fast IPTV player for LG webOS TVs. Sign in with your own Xtream Codes subscription. Coming soon."
>
  <SiteHeader />
  <main id="main">
    <div class="hero">
      <p class="eyebrow load">For LG smart TVs</p>
      <h1 class="hero-title load d1"><span class="dim">Lights off.</span> <span class="name">noir</span> <span class="dim">on.</span></h1>
      <p class="subline load d2">A calm, fast way to watch your TV subscription. Sign in with the login you already have, and press play.</p>
      <div class="actions load d3">
        <a class="btn" href="#player">See the player</a>
        <a class="link" href="#ui">Learn more →</a>
      </div>
      <TvFrame class="tv load d4" src={homeRows} priority sizes="(max-width: 1128px) 100vw, 1080px"
        alt="Noir home screen: a Continue watching row with progress bars above a row of colourful movie posters" />
    </div>

    <section id="ui" class="center">
      <div class="container reveal">
        <h2 class="title">The experience you always wanted.</h2>
        <p class="subline">Live TV, movies and shows, easy to browse and search. Calm, dark and simple to use.</p>
      </div>
      <div class="block-gap reveal">
        <div class="fan">
          <TvFrame class="side l" src={movies} sizes="(max-width: 900px) 100vw, 450px" alt="Movies screen with categories and a grid of posters" />
          <TvFrame class="mid" src={seriesList} sizes="(max-width: 900px) 100vw, 520px" alt="TV shows screen with categories and a grid of series posters" />
          <TvFrame class="side r" src={liveTv} sizes="(max-width: 900px) 100vw, 450px" alt="Live TV screen with channel categories and channel tiles" />
        </div>
        <div class="cols3 container">
          {captions.map(([t, p]) => <div><h3>{t}</h3><p>{p}</p></div>)}
        </div>
      </div>
    </section>

    <section id="player" class="center">
      <div class="container reveal">
        <h2 class="title">A player that works.</h2>
        <p class="subline">Everything you reach for while watching, one press away.</p>
      </div>
      <div class="container reveal" style="padding: 0">
        <Crop class="bar-crop" src={player} alt="Player controls: file size, title, elapsed and total time, end time, ten-second skips, pause, speed and subtitles" width="100%" left="0" top="-158%" aspect="1920 / 420" />
      </div>
      <div class="tiles reveal">
        {tiles.map(t => (
          <div class:list={['tile', t.cls]}>
            <div class="figure" aria-hidden="true">
              {t.figure === 'skip' ? <><span>›</span><span class="a2">›</span><span class="a3">›</span></> : t.figure}
            </div>
            <div><h3>{t.title}</h3><p>{t.text}</p></div>
          </div>
        ))}
      </div>
    </section>

    <section id="details" class="center">
      <div class="container reveal">
        <h2 class="title">The little things.</h2>
        <p class="subline">Small touches that make an evening of watching easier.</p>
      </div>
      <div class="cards">
        {cards.map(c => (
          <article class="card reveal">
            {c.audio ? (
              <div class="frame audio-panel" aria-hidden="true">
                <span class="word">Audio</span>
                <span class="pills"><span class="pill on">Track 1</span><span class="pill">Track 2</span><span class="pill">Track 3</span></span>
              </div>
            ) : (
              <Crop class="frame" src={c.img!} alt={c.alt!} width={c.width!} left={c.left!} top={c.top!} />
            )}
            <div class="text"><h3>{c.title}</h3><p>{c.text}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section id="setup" class="center">
      <div class="container reveal">
        <h2 class="title">Three steps to the sofa.</h2>
        <p class="subline">All you need is an LG smart TV and the login from your TV subscription.</p>
      </div>
      <ol class="steps container reveal">
        {steps.map(([t, p], i) => (
          <li><span class="num" class:list={{ last: i === 2 }} aria-hidden="true">{i + 1}</span><h3>{t}</h3><p>{p}</p></li>
        ))}
      </ol>
    </section>

    <section id="faq" class="center">
      <div class="container reveal"><h2 class="title">Questions.</h2></div>
      <div class="faq reveal">
        {faq.map(([q, a]) => (
          <details>
            <summary>{q}<span class="plus" aria-hidden="true">+</span></summary>
            <p class="answer">{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="get">
      <div class="inner reveal">
        <div class="app-icon" aria-hidden="true">noir</div>
        <h2 class="title">Coming to LG webOS.</h2>
        <p>Noir doesn’t come with channels or movies. You watch with the TV subscription you already have.</p>
        <button type="button" class="store" disabled aria-disabled="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4" width="19" height="13" rx="2"></rect><path d="M8 20.5h8"></path></svg>
          <span class="l"><span class="s">Coming soon to</span><span class="b">LG webOS</span></span>
        </button>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
