---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props { src: ImageMetadata; alt: string; priority?: boolean; sizes: string; class?: string }
const { src, alt, priority = false, sizes, class: className } = Astro.props
---
<div class:list={['tv-frame', className]}>
  <Image src={src} alt={alt} widths={[640, 1080, 1600, 1920]} sizes={sizes} format="webp"
    loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding={priority ? 'sync' : 'async'} />
</div>
